{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "reporters": ["html", "clear-text", "progress", "json"],
  "mutate": [
    "src/**/*.{ts,tsx}",
    "api/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "eval/**/*.ts",
    "!**/*.d.ts",
    "!src/main.tsx",
    "!src/vite-env.d.ts",
    "!src/test/**",
    "!src/**/*.test.{ts,tsx}",
    "!src/data/types.ts",
    "!api/**/*.test.ts",
    "!api/_schema.ts",
    "!scripts/**/*.test.{ts,mjs}",
    "!eval/**/*.test.ts",
    "!scripts/gif-scenarios/**",
    "!src/gql/**",
    "!shared/isoRegions.ts",
    "!src/lib/iconPaths.ts"
  ],
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  }
}
