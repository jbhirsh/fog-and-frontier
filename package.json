{
  "name": "fog-and-frontier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "patch-package",
    "build": "npm run lint && tsc -b && vite build",
    "typecheck": "tsc -b",
    "depcruise": "depcruise src api",
    "typecov": "npm run typecov:app && npm run typecov:api",
    "typecov:app": "type-coverage -p tsconfig.app.json --at-least 100 --detail --ignore-files \"src/gql/**\"",
    "typecov:api": "type-coverage -p tsconfig.api.json --at-least 100 --detail",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "db:seed-preview": "node scripts/seed-preview-db.mjs",
    "db:snapshot": "node scripts/snapshot-prod-db.mjs",
    "links:check": "node scripts/check-links.mjs",
    "instagram:check": "node --experimental-strip-types scripts/instagram-check.ts",
    "gif": "node --experimental-strip-types scripts/pr-gif-cli.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "eval": "TZ=America/Los_Angeles tsx eval/run-eval.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.3",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@clerk/backend": "^3.24.0",
    "@clerk/clerk-react": "^5.61.9",
    "@libsql/client": "^0.18.0",
    "@sentry/react": "^11.8.0",
    "@types/leaflet": "^1.9.22",
    "@vercel/blob": "^2.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.8.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.15",
    "type-coverage": "^2.30.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.2",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
