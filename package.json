{
  "name": "fog-and-frontier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "npm run lint && tsc -b && vite build",
    "typecheck": "tsc -b",
    "depcruise": "depcruise src api",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:seed-preview": "node scripts/seed-preview-db.mjs",
    "db:snapshot": "node scripts/snapshot-prod-db.mjs",
    "db:migrate-static": "node --experimental-strip-types scripts/migrate-static-to-turso.mjs",
    "db:backfill-park-types": "node --experimental-strip-types scripts/backfill-park-types.mjs",
    "db:backfill-restaurant-info": "node --experimental-strip-types scripts/backfill-restaurant-info.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "eval": "TZ=America/Los_Angeles tsx eval/run-eval.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@clerk/backend": "^3.16.10",
    "@clerk/clerk-react": "^5.61.9",
    "@libsql/client": "^0.17.4",
    "@sentry/react": "^10.70.0",
    "@types/leaflet": "^1.9.22",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "graphql": "^17.0.2",
    "graphql-scalars": "^1.25.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vercel/node": "^5.10.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "@sentry/core": "10.70.0"
  }
}
