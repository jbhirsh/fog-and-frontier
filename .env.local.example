# Copy to .env.local and fill in. Never commit .env.local.

# Keep VITE_OWNER_EMAILS (client UI hint) and OWNER_EMAILS (server gate) in
# sync. The server is the source of truth; if they drift, owner UI is enabled
# but server calls 401.

# Client-side (Vite-exposed)
VITE_OWNER_EMAILS=you@example.com,teammate@example.com
# CARTO basemap key (free: https://carto.com/basemaps/apikey). Public — it
# ships in every tile URL. Without it, map tiles render "API KEY REQUIRED".
VITE_CARTO_API_KEY=

# Server-side (Vercel Functions)
OWNER_EMAILS=you@example.com,teammate@example.com

# Sign-in (Better Auth, api/_betterAuth.ts). Sign-in shows only in builds
# Vercel makes (production, previews, `vercel dev`), which serve /api/auth.
# BETTER_AUTH_SECRET signs session cookies: its own random value per
# environment (`openssl rand -base64 32`), production's in production alone.
BETTER_AUTH_SECRET=
# Shared by production and previews: previews sign in with Google through
# production (the OAuth proxy). Random too.
OAUTH_PROXY_SECRET=
# A Google OAuth client (Google Cloud Console → APIs & Services →
# Credentials), its one redirect URI
# https://fog-and-frontier.vercel.app/api/auth/callback/google. The secret
# belongs to production only: previews and laptops never exchange a code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple (an Apple Developer account): off until the Services ID
# is set, which the app reads too, so production and previews both have it.
# Its return URL is https://fog-and-frontier.vercel.app/api/auth/callback/apple.
# The team ID, key ID and the key itself (the .p8 file's text) are
# production's alone: the server signs Apple's client secret from them.
VITE_APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Google One Tap, production only: a second Google
# OAuth client (no secret needed), its one JavaScript origin
# https://fog-and-frontier.vercel.app. Kept apart from the client above,
# whose tokens previews are handed, so a preview can't sign in with one.
VITE_GOOGLE_ONE_TAP_CLIENT_ID=
# Locally, the address `vercel dev` serves on, if not http://localhost:3000.
BETTER_AUTH_URL=

# Gemini (already in your prod/preview env)
GEMINI_API_KEY=

# Agent Search, for finding a drafted hike's AllTrails page (a Google Cloud API key
# restricted to the Discovery Engine API). Without it, a draft keeps the link its
# own Google Search found, unchecked.
AGENT_SEARCH_API_KEY=

# OpenRouteService, for driving miles (free: https://openrouteservice.org/dev/#/signup).
# Without it, distances are straight-line estimates marked "≈".
ORS_API_KEY=

# Vercel Blob, for owner photos (#19). Set automatically when a private Blob
# store is connected to the project; `vercel env pull` brings it down. Without
# it, photo uploads and the photo list fail.
BLOB_READ_WRITE_TOKEN=

# Turso (already in your prod/preview env)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
