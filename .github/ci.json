{
  "mutation": {
    "wiring": [
      "vite.config.ts",
      "src/test/setup.ts",
      "tsconfig*.json",
      "package.json",
      "package-lock.json",
      "patches/**",
      ".github/workflows/mutation.yml"
    ],
    "smoke": ["src/lib/viewMode.ts", "src/lib/mapBounds.ts"],
    "cache": {
      "restoreMain": false,
      "restartOn": [
        "package-lock.json",
        "patches/**",
        "stryker.config.json",
        "vite.config.ts",
        "src/test/**"
      ]
    },
    "sweep": {
      "shards": 8,
      "timeoutMinutes": 90
    }
  },
  "visuals": {
    "ui": ["src/**/*.{tsx,css}"],
    "notUi": ["**/*.test.tsx", "src/test/**"]
  },
  "audit": {
    "graph": ["src", "api"]
  },
  "readme-screenshots": {
    "shows": [
      "src/**",
      "index.html",
      "public/**",
      "scripts/readme-screenshots.ts",
      "scripts/pr-gif.ts",
      "scripts/pr-gif-cli.ts"
    ],
    "ignore": ["**/*.test.{ts,tsx}", "src/test/**"],
    "source": "a local production build reading production's catalog and photos (scripts/readme-screenshots.ts)"
  }
}
