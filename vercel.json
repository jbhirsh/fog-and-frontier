{
  "ignoreCommand": "l=$(git log -1 --format='%an|%cn'); echo \"ci51 an|cn=$l env=$VERCEL_ENV\"; [ \"$VERCEL_ENV\" = preview ] && [ \"${l#*|}\" = 'github-actions[bot]' ] && [ \"${l%|*}\" != 'github-actions[bot]' ]",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/graphql"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "images": {
    "sizes": [96, 192, 384, 640, 960, 1280],
    "qualities": [75],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "upload.wikimedia.org"
      },
      {
        "protocol": "https",
        "hostname": "thumb.wikimedia.org"
      },
      {
        "protocol": "https",
        "hostname": "images.unsplash.com"
      },
      {
        "protocol": "https",
        "hostname": "live.staticflickr.com"
      },
      {
        "protocol": "https",
        "hostname": "www.nps.gov"
      },
      {
        "protocol": "https",
        "hostname": "imgc.ssmedia.com"
      },
      {
        "protocol": "https",
        "hostname": "www.gocalaveras.com"
      },
      {
        "protocol": "https",
        "hostname": "hiddenca.com"
      }
    ]
  }
}
